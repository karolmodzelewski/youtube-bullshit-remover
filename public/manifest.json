{
    "manifest_version": 3,
    "name": "YouTube Bullshit Remover",
    "version": "1.0.0",
    "description": "Hides Shorts, Most Relevant section and other bullshit on YouTube.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "YouTube Bullshit Remover",
        "default_popup": "popup.html"
    },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
            "js": ["content.js"],
            "css": ["content.css"],
            "run_at": "document_start",
            "all_frames": false
        }
    ]
}
